# Copy this file to .env and fill in your values.

# ── LLM (ชี้ไป DGX gemma ผ่าน Tailscale, OpenAI-compatible /v1 ของ Ollama) ──────
LLM_BASE_URL=http://dgx:11434/v1
LLM_MODEL=gemma4:26b
LLM_API_KEY=ollama

# ── MCP server (หน้าบ้านใหม่ — App ต่อผ่าน Tailscale IP) ───────────────────────
# bind 0.0.0.0 เพื่อให้เข้าถึงผ่าน Tailscale IP 100.x ได้
MCP_HOST=0.0.0.0
MCP_PORT=8765
# token บางๆ กันแอปแปลกในวง (ด่านหลักคือ Tailscale ACL) — ว่าง = ไม่เช็ค
MCP_TOKEN=
# token สำหรับหน้าเว็บควบคุมผู้ดูแลระบบ — ว่าง = ไม่เช็ค (เปิดสาธารณะในวงแลน/Tailscale)
ADMIN_TOKEN=

# ── Web Search (optional — ให้ hub agent ค้นเว็บระหว่างทำงาน) ──────────────────
SERPER_API_KEY=

# ── MQTT Broker (App↔Node + Hub broadcast discovery) — แยกขาดจาก Tailscale ─────
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=8883
MQTT_USE_TLS=true

# ── Agent Identity ────────────────────────────────────────────────────────────
# discovery publish ที่: {MQTT_BASE_TOPIC}/hub/{AGENT_NAME}/status (retained)
MQTT_BASE_TOPIC=Mylab/smarthome
AGENT_NAME=office-pc

# ── Timeout ───────────────────────────────────────────────────────────────────
COMMAND_TIMEOUT=60

# ── Disable telemetry ─────────────────────────────────────────────────────────
OTEL_SDK_DISABLED=true
